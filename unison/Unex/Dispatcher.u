-- Unex Dispatcher
--
-- A long-running Unison program that receives serialized Value thunks over a
-- localhost TCP socket, evaluates them, and writes results back over the same
-- socket. Missing code dependencies are fetched from the Unex server via
-- HTTP using the same baseUrl/secret.
--
-- The protocol runs over a socket (not stdin/stdout) so that user-written
-- services are free to read stdin and write stdout/stderr without corrupting
-- the request/response stream. Elixir owns the listen socket and writes
-- UNEX_DISPATCHER_PORT into the environment before spawning this program.
--
-- Wire format (request):   [len:8 BE][value_bytes]
-- Wire format (response):  [len:8 BE][status:1][payload]
--   status 0x00 — OK, payload is UTF-8 result Text
--   status 0xFF — error, payload is UTF-8 error message
--
-- Environment:
--   UNEX_URL              — Unex server base URL, for GET /code/:termhash
--   UNEX_SECRET           — Bearer token for the above
--   UNEX_DISPATCHER_PORT  — TCP port on 127.0.0.1 to connect back to

Unex.Dispatcher.logErr : Text ->{IO, Exception} ()
Unex.Dispatcher.logErr msg =
  Handle.putBytes Handle.stdErr (Text.toUtf8 ("[dispatcher] " Text.++ msg Text.++ "\n"))

-- Receive exactly n bytes from the socket, accumulating across recv calls.
-- Returns `Some (extracted, leftover_buf)` or `None` if the socket closed
-- before n bytes arrived. The leftover must be threaded into the next call
-- so bytes that arrive in the same packet as a preceding frame aren't lost.
Unex.Dispatcher.recvExact :
  Socket -> Bytes -> Nat ->{IO, Exception} Optional (Bytes, Bytes)
Unex.Dispatcher.recvExact sock acc n =
  have = Bytes.size acc
  if have >= n then
    Some (Bytes.take n acc, Bytes.drop n acc)
  else
    chunk = Socket.receive sock
    if Bytes.size chunk == 0 then None
    else Unex.Dispatcher.recvExact sock (acc Bytes.++ chunk) n

-- Send exactly these bytes. Socket.send handles buffering internally.
Unex.Dispatcher.sendFrame : Socket -> Bytes ->{IO, Exception} ()
Unex.Dispatcher.sendFrame sock payload =
  use Bytes ++
  lenBytes = Nat.toBytesBigEndian (Bytes.size payload)
  Socket.send sock (lenBytes ++ payload)

Unex.Dispatcher.ok : Bytes -> Bytes
Unex.Dispatcher.ok body = Bytes.fromList [0] Bytes.++ body

Unex.Dispatcher.err : Text -> Bytes
Unex.Dispatcher.err msg = Bytes.fromList [255] Bytes.++ Text.toUtf8 msg

Unex.Dispatcher.termHash : Link.Term -> Text
Unex.Dispatcher.termHash t =
  full = Link.Term.toText t
  if Text.take 1 full == "#" then Text.drop 1 full else full

Unex.Dispatcher.fetchCode :
  Text -> Text -> Link.Term ->{IO, Exception, Http, Threads} Code
Unex.Dispatcher.fetchCode baseUrl secret t =
  url  = baseUrl Text.++ "/code/" Text.++ Unex.Dispatcher.termHash t
  req  = Unex.Http.authHeader secret (HttpRequest.get (URI.parse url))
  resp = Http.request req
  body = Body.toBytes (HttpResponse.body resp)
  Code.deserialize body

-- Iteratively call Code.cache_ with an accumulating set of (term, code) pairs
-- until it reports no more missing deps.
Unex.Dispatcher.satisfy :
  Text -> Text -> [(Link.Term, Code)] -> [Link.Term]
  ->{IO, Exception, Http, Threads} ()
Unex.Dispatcher.satisfy baseUrl secret acc needed = match needed with
  [] ->
    stillMissing = Code.cache_ acc
    if List.isEmpty stillMissing then ()
    else Unex.Dispatcher.satisfy baseUrl secret acc stillMissing
  _  ->
    newPairs     =
      List.map (t -> (t, Unex.Dispatcher.fetchCode baseUrl secret t)) needed
    acc'         = acc List.++ newPairs
    stillMissing = Code.cache_ acc'
    if List.isEmpty stillMissing then ()
    else Unex.Dispatcher.satisfy baseUrl secret acc' stillMissing

-- Services are `'{IO, Exception} ()` — they produce their output via printLine
-- or similar, and we capture the subprocess's stdout on the Elixir side. The
-- dispatcher just needs to run the thunk for its side effects and report
-- success or a loader failure.
Unex.Dispatcher.handleOne :
  Text -> Text -> Bytes ->{IO, Exception, Http, Threads} Bytes
Unex.Dispatcher.handleOne baseUrl secret valueBytes =
  v = Value.deserialize valueBytes
  loaded : Either [Link.Term] ('{IO, Exception} ())
  loaded = Value.load v
  match loaded with
    Right thunk ->
      !thunk
      Unex.Dispatcher.ok Bytes.empty
    Left missing ->
      Unex.Dispatcher.satisfy baseUrl secret [] missing
      retry : Either [Link.Term] ('{IO, Exception} ())
      retry = Value.load v
      match retry with
        Right thunk2 ->
          !thunk2
          Unex.Dispatcher.ok Bytes.empty
        Left stillMissing ->
          Unex.Dispatcher.err
            ("Value.load still missing "
              Text.++ Nat.toText (List.size stillMissing) Text.++ " after fetch")

Unex.Dispatcher.loop :
  Text -> Text -> Socket -> Bytes ->{IO, Exception, Http, Threads} ()
Unex.Dispatcher.loop baseUrl secret sock buf =
  match Unex.Dispatcher.recvExact sock buf 8 with
    None          -> ()
    Some (lenBytes, rest1) ->
      lenOpt = Abort.toOptional! do Nat.fromBytesBigEndian lenBytes
      len    = Optional.getOrElse 0 lenOpt
      match Unex.Dispatcher.recvExact sock rest1 len with
        None -> ()
        Some (payload, rest2) ->
          response =
            catch do Unex.Dispatcher.handleOne baseUrl secret payload
          respBytes = match response with
            Right bs -> bs
            Left f   -> Unex.Dispatcher.err (Failure.message f)
          Unex.Dispatcher.sendFrame sock respBytes
          Unex.Dispatcher.loop baseUrl secret sock rest2

Unex.Dispatcher.main : '{IO, Exception} ()
Unex.Dispatcher.main = do
  -- Disable stdout buffering so the service program's `printLine` output
  -- arrives at the parent (Elixir) process in real time — we capture it on
  -- the Elixir side and return it as the service's result.
  Handle.setBuffering Handle.stdOut NoBuffering
  url      = Optional.getOrElse "http://localhost:4040" (Either.toOptional (catch do IO.getEnv "UNEX_URL"))
  secret   = Optional.getOrElse "" (Either.toOptional (catch do IO.getEnv "UNEX_SECRET"))
  portText = match catch do IO.getEnv "UNEX_DISPATCHER_PORT" with
    Right p -> p
    Left _  -> bug "UNEX_DISPATCHER_PORT not set"
  Unex.Dispatcher.logErr
    ("connecting to 127.0.0.1:" Text.++ portText Text.++ " server=" Text.++ url)
  sock = Socket.client (HostName "127.0.0.1") (Port.Port portText)
  Threads.run do
    Http.run do
      Unex.Dispatcher.loop url secret sock Bytes.empty
