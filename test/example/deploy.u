-- Step 2 of 2: Deploy and release the service.
--
-- Run after `load test/example/service.u` and `add` so that
-- mainService is in the codebase and termLink can resolve its hash.
--
-- Workflow from UCM:
--   3. load test/example/deploy.u
--   4. run mainDeploy

deployScript : '{Unex.Services, IO, Exception} ()
deployScript = do
  -- Push compiled bytecode; returns the Unison hash
  hash = Unex.Services.deploy "my-service" (termLink mainService)
  -- Point the name at the hash (or re-release to update to a new version)
  Unex.Services.release "my-service" hash
  printLine ("Deployed: " ++ hash)

mainDeploy : '{IO, Exception} ()
mainDeploy = Unex.main deployScript
