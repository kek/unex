<header class="border-b border-zinc-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-3 flex gap-4 items-center">
    <span class="font-semibold">Unex</span>
    <nav class="flex gap-3 text-sm">
      <.link navigate={~p"/"} class="hover:underline">Home</.link>
      <.link navigate={~p"/services"} class="hover:underline">Services</.link>
      <.link navigate={~p"/dashboard"} class="hover:underline">Metrics</.link>
    </nav>
  </div>
</header>
<main class="mx-auto max-w-6xl px-4 py-6">
  {@inner_content}
</main>
