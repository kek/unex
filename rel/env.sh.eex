#!/bin/sh

# Translate UNEX_NODE and UNEX_COOKIE into BEAM VM flags.
# This runs before the BEAM starts, so it can set --sname/--name and --cookie.

if [ -n "$UNEX_NODE" ]; then
  case "$UNEX_NODE" in
    *@*)
      export RELEASE_DISTRIBUTION=name
      export RELEASE_NODE="$UNEX_NODE"
      ;;
    *)
      export RELEASE_DISTRIBUTION=sname
      export RELEASE_NODE="$UNEX_NODE"
      ;;
  esac
else
  # Without UNEX_NODE, Mix.Release defaults to sname which derives the node
  # name from the OS hostname. In containers with rotating hostnames (podman
  # container IDs, k8s pod names, etc.) this means the node name changes on
  # every restart — which breaks Mnesia disc_copies, since tables are tagged
  # with the node that created them. Disable distribution so the node stays
  # nonode@nohost across restarts. Single-node deployments don't need it.
  export RELEASE_DISTRIBUTION=none
fi

if [ -n "$UNEX_COOKIE" ]; then
  export RELEASE_COOKIE="$UNEX_COOKIE"
fi
